---
import { Image } from "astro:assets";
import { cases } from "../lib/carousel";

const total = cases.length;
---

<section
  class="slide gallery"
  id={`s13`}
  data-slide="12"
  aria-roledescription="slide"
  aria-label={`13 — Os estojos`}
>
  <div class="frame">
    <header class="g-head">
      <p class="kicker" data-g-reveal>04 — Os estojos</p>
      <h2 class="g-title" data-g-reveal data-g-delay="1">
        Uma coleção,<br />sete caracteres.
      </h2>
    </header>

    <div
      class="carousel"
      data-carousel
      role="group"
      aria-roledescription="carrossel"
      aria-label="Estojos RAYO"
    >
      <ol class="track" data-track>
        {
          cases.map((item, i) => (
            <li class="card" data-card data-index={i}>
              <div class="media">
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[520, 900, 1400]}
                  sizes="(max-width: 780px) 82vw, 46vw"
                  loading={i < 2 ? "eager" : "lazy"}
                />
              </div>
              <div class="cap">
                <span class="idx">{String(i + 1).padStart(2, "0")}</span>
                <p class="name">{item.name}</p>
                <p class="spec">{item.spec}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="g-nav">
        <button type="button" data-g="prev" aria-label="Anterior">
          <span aria-hidden="true">←</span>
        </button>
        <p class="g-count">
          <b data-g-cur>01</b> / {String(total).padStart(2, "0")}
        </p>
        <button type="button" data-g="next" aria-label="Próximo">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/carousel.ts";
</script>

<style>
  .gallery .frame {
    aspect-ratio: auto;
    width: 100%;
    max-width: 1600px;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(24px, 5vw, 72px) 0;
  }

  .g-head {
    padding: 0 clamp(20px, 5vw, 72px);
    display: grid;
    gap: 14px;
  }
  .kicker {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .g-title {
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  /* entrance for header bits */
  [data-g-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .slide.in [data-g-reveal] {
    opacity: 1;
    transform: none;
  }
  .slide.in [data-g-reveal][data-g-delay="1"] {
    transition-delay: 0.12s;
  }

  .carousel {
    display: grid;
    gap: clamp(18px, 2.5vw, 30px);
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 0 clamp(20px, 5vw, 72px);
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .card {
    flex: 0 0 auto;
    width: min(82vw, 640px);
    scroll-snap-align: center;
  }

  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0b0b0b;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* clip-reveal when the section enters */
    clip-path: inset(0 100% 0 0);
    transform: scale(1.08);
    transition:
      clip-path 0.9s var(--ease),
      transform 1.2s var(--ease);
  }
  .slide.in .media :global(img) {
    clip-path: inset(0 0 0 0);
    transform: scale(1);
  }

  .cap {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "idx name"
      "idx spec";
    column-gap: 14px;
    align-items: baseline;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    margin-top: 14px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
  }
  .slide.in .cap {
    opacity: 1;
    transform: none;
    transition-delay: 0.35s;
  }
  .idx {
    grid-area: idx;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--bolt);
    font-variant-numeric: tabular-nums;
  }
  .name {
    grid-area: name;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .spec {
    grid-area: spec;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 3px;
  }

  .g-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 clamp(20px, 5vw, 72px);
  }
  .g-nav button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 0.95rem;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }
  .g-nav button:hover:not(:disabled) {
    background: var(--white);
    color: var(--black);
    border-color: var(--white);
  }
  .g-nav button:disabled {
    opacity: 0.3;
  }
  .g-count {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .g-count b {
    color: var(--white);
  }
</style>
