---
import { Image } from "astro:assets";
import { shots } from "../lib/carousel";
---

<section
  class="slide gallery"
  id="s11"
  data-slide="10"
  aria-label="Estojos RAYO — galeria"
>
  <div class="cf" data-cf>
    <ul class="cf-track" data-cf-track>
      {
        shots.map((shot, i) => (
          <li class="cf-cell" data-cf-cell data-i={i}>
            <button
              type="button"
              class="cf-open"
              data-open={i}
              data-full={shot.src.src}
              aria-label={`Ampliar imagem ${i + 1} de ${shots.length}`}
            >
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[420, 760, 1100]}
                sizes="(max-width: 780px) 60vw, 30vw"
                loading={i < 3 ? "eager" : "lazy"}
                decoding="async"
                draggable={false}
              />
            </button>
          </li>
        ))
      }
    </ul>

    <button type="button" class="cf-arw prev" data-cf-nav="-1" aria-label="Anterior">
      <span aria-hidden="true">‹</span>
    </button>
    <button type="button" class="cf-arw next" data-cf-nav="1" aria-label="Próximo">
      <span aria-hidden="true">›</span>
    </button>

    <div class="cf-dots" role="tablist" aria-label="Estojos">
      {
        shots.map((_, i) => (
          <button
            type="button"
            class="cf-dot"
            data-cf-dot={i}
            aria-label={`Ir para imagem ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<div
  class="lightbox"
  data-lightbox
  role="dialog"
  aria-modal="true"
  aria-label="Imagem ampliada"
  hidden
>
  <button type="button" class="lb-close" data-lb-close aria-label="Fechar">
    <span aria-hidden="true">×</span>
  </button>
  <img data-lb-img alt="" />
</div>

<style>
  .gallery {
    display: block;
    background: var(--black);
    overflow: hidden;
  }
  .cf {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
    perspective: 1600px;
    touch-action: pan-y;
    cursor: grab;
  }
  .cf:active {
    cursor: grabbing;
  }

  .cf-track {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  .cf-cell {
    position: absolute;
    top: 50%;
    left: 50%;
    will-change: transform, opacity;
  }
  .cf-open {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    line-height: 0;
    cursor: zoom-in;
  }
  .cf-open :global(img) {
    height: clamp(240px, 54svh, 560px);
    width: auto;
    max-width: 72vw;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .cf-arw {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 900;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    color: var(--white);
    opacity: 0.5;
    transition: opacity 0.2s var(--ease);
  }
  .cf-arw:hover {
    opacity: 1;
  }
  .cf-arw.prev {
    left: clamp(6px, 2vw, 26px);
  }
  .cf-arw.next {
    right: clamp(6px, 2vw, 26px);
  }

  .cf-dots {
    position: absolute;
    left: 50%;
    bottom: clamp(58px, 9vw, 96px);
    transform: translateX(-50%);
    z-index: 900;
    display: flex;
    gap: 10px;
  }
  .cf-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    background: rgba(255, 255, 255, 0.24);
    transition:
      background-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .cf-dot[aria-current="true"] {
    background: var(--bolt);
    transform: scale(1.5);
  }

  /* lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 56px);
    background: rgba(0, 0, 0, 0.93);
    animation: lb-in 0.28s var(--ease);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-out;
  }
  .lb-close {
    position: absolute;
    top: clamp(10px, 2.5vw, 26px);
    right: clamp(10px, 2.5vw, 26px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--white);
    opacity: 0.7;
    transition: opacity 0.2s var(--ease);
  }
  .lb-close:hover {
    opacity: 1;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      animation: none;
    }
  }
</style>

<script>
  import "../scripts/carousel.ts";
</script>
