---
import { Image } from "astro:assets";
import { slides } from "../lib/slides";

const total = slides.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="bar" aria-hidden="true"><i id="bar"></i></div>

<main id="deck" aria-label="RAYO Eyewear — Collection 01">
  {
    slides.map((slide, i) => (
      <section
        class="slide"
        id={`s${i + 1}`}
        data-slide={i}
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${total} — ${slide.label}`}
      >
        <div class="frame">
          {slide.video ? (
            <video
              data-video
              poster={slide.src.src}
              muted
              loop
              playsinline
              preload={i < 3 ? "auto" : "metadata"}
              aria-label={slide.alt}
            >
              <source src={`${slide.video}.webm`} type="video/webm" />
              <source src={`${slide.video}.mp4`} type="video/mp4" />
            </video>
          ) : (
            <Image
              src={slide.src}
              alt={slide.alt}
              widths={[1280, 1920, 2560, 3840]}
              sizes="100vw"
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
            />
          )}
        </div>
      </section>
    ))
  }
</main>

<div class="hud">
  <button type="button" class="arw" data-nav="prev" aria-label="Slide anterior">
    <span aria-hidden="true">↑</span>
  </button>
  <p class="count" aria-live="polite">
    <b id="count-cur">{pad(1)}</b><span> / {pad(total)}</span>
  </p>
  <button type="button" class="arw" data-nav="next" aria-label="Próximo slide">
    <span aria-hidden="true">↓</span>
  </button>
</div>

<button type="button" id="fs" class="fs" aria-label="Tela cheia">
  <span aria-hidden="true">⤢</span>
</button>

<p class="hint" id="hint" aria-hidden="true">
  Role <span aria-hidden="true">↓</span>
</p>

<script>
  import "../scripts/deck.ts";
</script>

<style>
  /* scroll progress — top */
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 30;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--bolt);
  }

  /* counter + jump arrows — bottom center, fixed */
  .hud {
    position: fixed;
    left: 50%;
    bottom: clamp(14px, 2.4vw, 26px);
    transform: translateX(-50%);
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 14px;
    mix-blend-mode: difference;
  }
  .count {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    font-variant-numeric: tabular-nums;
    color: var(--white);
    user-select: none;
  }
  .count span {
    opacity: 0.55;
  }
  .arw {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--white);
    opacity: 0.55;
    transition: opacity 0.2s var(--ease);
  }
  .arw:hover {
    opacity: 1;
  }

  .fs {
    position: fixed;
    right: clamp(12px, 2vw, 22px);
    bottom: clamp(12px, 2vw, 22px);
    z-index: 30;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    color: var(--white);
    opacity: 0.4;
    mix-blend-mode: difference;
    transition: opacity 0.2s var(--ease);
  }
  .fs:hover {
    opacity: 1;
  }

  .hint {
    position: fixed;
    left: 50%;
    bottom: calc(clamp(14px, 2.4vw, 26px) + 30px);
    transform: translateX(-50%);
    z-index: 30;
    font-size: 0.6875rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--white);
    opacity: 0.4;
    mix-blend-mode: difference;
    transition: opacity 0.5s var(--ease);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hint span {
    animation: nudge 1.6s var(--ease) infinite;
  }
  .hint.gone {
    opacity: 0;
    pointer-events: none;
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 640px) {
    .fs {
      display: none;
    }
  }
</style>
