---
import { Image } from "astro:assets";
import { slides } from "../lib/slides";
import Carousel from "./Carousel.astro";
import redOpen from "../assets/slides/12.jpg";
import redClosed from "../assets/slides/12-closed.jpg";

// 10 Canva slides → gallery → composed Red Edition pair (open + closed).
const total = slides.length + 2;
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="bar" aria-hidden="true"><i id="bar"></i></div>

<main id="deck" aria-label="RAYO Eyewear — Collection 01">
  {
    slides.map((slide, i) => (
      <section
        class="slide"
        id={`s${i + 1}`}
        data-slide={i}
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${total} — ${slide.label}`}
      >
        <div class="frame">
          {slide.video ? (
            <video
              data-video
              poster={slide.src.src}
              muted
              loop
              playsinline
              preload={i < 3 ? "auto" : "metadata"}
              aria-label={slide.alt}
            >
              <source src={`${slide.video}.webm`} type="video/webm" />
              <source src={`${slide.video}.mp4`} type="video/mp4" />
            </video>
          ) : (
            <Image
              src={slide.src}
              alt={slide.alt}
              widths={[1280, 1920, 2560, 3840]}
              sizes="100vw"
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
            />
          )}
        </div>
      </section>
    ))
  }

  <Carousel />

  <section
    class="slide"
    id="s12"
    data-slide="11"
    aria-roledescription="slide"
    aria-label={`12 / ${total} — Red Edition`}
  >
    <div class="frame redpair">
      <figure class="rp rp-open">
        <Image
          src={redOpen}
          alt="Estojo origami RAYO preto aberto com forro de camurça vermelha, sobre pedra molhada."
          widths={[900, 1400, 2048]}
          sizes="90vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="rp rp-closed">
        <Image
          src={redClosed}
          alt="Estojo RAYO preto fechado com faixa elástica vermelha, sobre fundo vermelho."
          widths={[500, 900]}
          sizes="45vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>
</main>

<div class="hud">
  <button type="button" class="arw" data-nav="prev" aria-label="Anterior">
    <span aria-hidden="true">↑</span>
  </button>
  <p class="count" aria-live="polite">
    <b id="count-cur">{pad(1)}</b><span> / {pad(total)}</span>
  </p>
  <button type="button" class="arw" data-nav="next" aria-label="Próximo">
    <span aria-hidden="true">↓</span>
  </button>
</div>

<button type="button" id="fs" class="fs" aria-label="Tela cheia">
  <span aria-hidden="true">⤢</span>
</button>

<p class="hint" id="hint" aria-hidden="true">
  Role <span aria-hidden="true">↓</span>
</p>

<script>
  import "../scripts/deck.ts";
</script>

<style>
  /* Red Edition — open shot + closed shot stacked (composed, like the Brasil slide) */
  .redpair {
    aspect-ratio: 5 / 6;
    width: min(62vw, 62svh);
  }
  .redpair {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: clamp(10px, 1.6vw, 20px);
    align-content: center;
  }
  .redpair .rp {
    margin: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .redpair .rp :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .redpair .rp-closed :global(img) {
    transform: scale(0.86);
  }

  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 30;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--bolt);
  }

  .hud {
    position: fixed;
    left: 50%;
    bottom: clamp(14px, 2.4vw, 26px);
    transform: translateX(-50%);
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 14px;
    mix-blend-mode: difference;
  }
  .count {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    font-variant-numeric: tabular-nums;
    color: var(--white);
    user-select: none;
  }
  .count span {
    opacity: 0.55;
  }
  .arw {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--white);
    opacity: 0.55;
    transition: opacity 0.2s var(--ease);
  }
  .arw:hover {
    opacity: 1;
  }

  .fs {
    position: fixed;
    right: clamp(12px, 2vw, 22px);
    bottom: clamp(12px, 2vw, 22px);
    z-index: 30;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    color: var(--white);
    opacity: 0.4;
    mix-blend-mode: difference;
    transition: opacity 0.2s var(--ease);
  }
  .fs:hover {
    opacity: 1;
  }

  .hint {
    position: fixed;
    left: 50%;
    bottom: calc(clamp(14px, 2.4vw, 26px) + 30px);
    transform: translateX(-50%);
    z-index: 30;
    font-size: 0.6875rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--white);
    opacity: 0.4;
    mix-blend-mode: difference;
    transition: opacity 0.5s var(--ease);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hint span {
    animation: nudge 1.6s var(--ease) infinite;
  }
  .hint.gone {
    opacity: 0;
    pointer-events: none;
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 640px) {
    .fs {
      display: none;
    }
  }
</style>
